          "widget": {
            "name": "cdf_latency_ts",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_cdf_ts",
                  "fields": [
                    {
                      "name": "ts",
                      "expression": "`ts`"
                    },
                    {
                      "name": "percentile",
                      "expression": "`percentile`"
                    },
                    {
                      "name": "max(latency_s)",
                      "expression": "MAX(`latency_s`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "ts",
                  "displayName": "Time",
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "fieldName": "max(latency_s)",
                  "displayName": "Replication latency (s)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "format": {
                    "type": "number",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 2
                    }
                  }
                },
                "color": {
                  "fieldName": "percentile",
                  "displayName": "Percentile",
                  "scale": {
                    "type": "categorical"
                  }
                }
              },
              "frame": {
                "showTitle": true,
