{
  "datasets": [
    {
      "name": "ds_summary",
      "displayName": "Project summary",
      "queryLines": [
        "SELECT * FROM v_project_summary ORDER BY project_id "
      ]
    },
    {
      "name": "ds_cost",
      "displayName": "Lakebase cost (system.billing)",
      "queryLines": [
        "SELECT project_id, usage_hour, cost_type, sum(usage_quantity) AS usage_quantity, sum(list_cost_usd) AS list_cost_usd FROM v_lakebase_cost GROUP BY project_id, usage_hour, cost_type ORDER BY usage_hour "
      ]
    },
    {
      "name": "ds_billing_status",
      "displayName": "Billing data status",
      "queryLines": [
        "SELECT billing_status FROM v_billing_status "
      ]
    },
    {
      "name": "ds_compute",
      "displayName": "Compute samples",
      "queryLines": [
        "SELECT project_id, ts, avg(cu_utilization) AS cu_utilization, avg(db_load) AS db_load FROM v_compute_samples GROUP BY project_id, ts ORDER BY ts "
      ]
    },
    {
      "name": "ds_latency_op",
      "displayName": "Latency by operation",
      "queryLines": [
        "SELECT * FROM v_latency_by_op WHERE op <> 'insert_batch' ORDER BY op, project_id "
      ]
    },
    {
      "name": "ds_cdf_ts",
      "displayName": "CDF replication latency over time",
      "queryLines": [
        "SELECT project_id, ts, 'Median' AS percentile, p50_latency_s AS latency_s FROM v_cdf_timeseries UNION ALL SELECT project_id, ts, 'P95' AS percentile, p95_latency_s AS latency_s FROM v_cdf_timeseries ORDER BY ts "
      ]
    }
  ],
  "pages": [
